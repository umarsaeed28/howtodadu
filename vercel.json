{
  "services": {
    "web": {
      "root": ".",
      "framework": "nextjs",
      "bindings": [{ "type": "service", "service": "pencil_api", "format": "url", "env": "PENCIL_API_URL" }]
    },
    "pencil_api": {
      "root": "services/api/",
      "framework": "fastapi",
      "entrypoint": "app.main:app"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": { "service": "web" } }],
  "crons": [{ "path": "/api/cron/refresh-listings", "schedule": "0 */12 * * *" }]
}
