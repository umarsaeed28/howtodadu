# =====================================================================================================
#  PENCIL CREDENTIALS  (template; the real file is .env.credentials, which git ignores)
#
#  Fill in the values in .env.credentials (same layout as this file). Leave a line blank if you do not
#  have it yet; the app runs without most of them and switches each service on once its key is present.
#  Never paste these into chat or commit them. Rotate any key you think has leaked.
# =====================================================================================================


# -----------------------------------------------------------------------------------------------------
# 1. AI MODELS
# -----------------------------------------------------------------------------------------------------

# Anthropic (Claude): makes the final DADU call. REQUIRED for AI assessments.
#   console.anthropic.com -> Settings -> API Keys -> Create Key. Starts with "sk-ant-".
#   Also set a monthly spend limit: Settings -> Limits.
ANTHROPIC_API_KEY=

# Groq: fast, free inference for the small jobs (listing extraction, query rewriting, eval judging).
#   console.groq.com -> API Keys -> Create API Key. Starts with "gsk_". Free tier, no card needed.
GROQ_API_KEY=

# Jina AI: embeddings for the knowledge base (jina-embeddings-v3, 1024 dimensions).
#   jina.ai/embeddings -> the page shows a free API key (10M free tokens), or sign in at jina.ai -> API Keys.
#   Starts with "jina_".
JINA_API_KEY=


# -----------------------------------------------------------------------------------------------------
# 2. AWS (backend + database, paid from your $200 credit)
# -----------------------------------------------------------------------------------------------------

# Your 12-digit account ID: AWS console -> click your name (top right) -> Account ID.
AWS_ACCOUNT_ID=

# Region to deploy in. us-west-2 (Oregon) is closest to Seattle with the full free tier.
AWS_REGION=us-west-2

# A one-time "bootstrap" access key so I can run OpenTofu the first time. After that, GitHub Actions
# deploys with short-lived OIDC credentials and you should delete this key.
#   AWS console -> IAM -> Users -> Create user "pencil-bootstrap" -> Attach policies directly ->
#   AdministratorAccess -> Create. Open the user -> Security credentials -> Create access key ->
#   "Command Line Interface (CLI)" -> copy both values.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Where budget alerts and CloudWatch alarms are emailed (you will get one confirmation email from AWS SNS).
ALERT_EMAIL=

# Monthly AWS budget in USD for the alert (alerts at 50%, 80% and 100%).
AWS_MONTHLY_BUDGET_USD=25


# -----------------------------------------------------------------------------------------------------
# 3. FRONTEND HOSTING (Vercel)
# -----------------------------------------------------------------------------------------------------

# Easiest: vercel.com -> Add New -> Project -> import GitHub repo umarsaeed28/howtodadu. No token needed.
# If you want me to deploy from here instead, create a token:
#   vercel.com/account/tokens -> Create Token (scope: your account).
VERCEL_TOKEN=
# Filled in by `vercel link` (they appear in .vercel/project.json). Leave blank; I will fill them.
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=


# -----------------------------------------------------------------------------------------------------
# 4. GITHUB (CI/CD)
# -----------------------------------------------------------------------------------------------------

GITHUB_REPO=umarsaeed28/howtodadu

# Optional: lets me add the CI secrets to the repo for you. Otherwise I will give you the list to paste.
#   github.com/settings/personal-access-tokens -> Generate new token (fine-grained) ->
#   Only select repositories: howtodadu -> Permissions: Secrets (read and write), Actions (read and write),
#   Contents (read and write), Pull requests (read and write).
GITHUB_TOKEN=


# -----------------------------------------------------------------------------------------------------
# 5. MONITORING
# -----------------------------------------------------------------------------------------------------

# Sentry: production errors for the website and the API (free Developer plan).
#   sentry.io -> Create project "pencil-web" (platform Next.js) and "pencil-api" (platform FastAPI).
#   Each project -> Settings -> Client Keys (DSN) -> copy the DSN.
SENTRY_DSN_WEB=
SENTRY_DSN_API=
#   Org slug: sentry.io/organizations/<this-part>/
SENTRY_ORG=
#   For readable stack traces (source map upload): Settings -> Developer Settings -> Organization Tokens -> Create.
SENTRY_AUTH_TOKEN=

# Opik (by Comet): traces every LLM call (free cloud plan).
#   comet.com/signup (choose Opik) -> click your avatar -> API Key. Workspace = your Comet username.
OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_PROJECT_NAME=pencil


# -----------------------------------------------------------------------------------------------------
# 6. LISTINGS (live data)
# -----------------------------------------------------------------------------------------------------

# Which source feeds the map: dealmachine (live), fixture (sample data), redfin, or none.
LISTINGS_PROVIDER=dealmachine

# DealMachine: active MLS listings, pulled every 2 days at 11am Pacific (about 650 homes, 1 credit each per month).
#   app.dealmachine.com -> Settings -> API -> Create key. Starts with "dm_sk_live_". Also add it in Vercel.
DEALMACHINE_API_KEY=

# HasData: live Redfin listings (older option). The current key returns errors; create a fresh one.
#   app.hasdata.com -> Dashboard -> API Key (copy / regenerate). Check the plan has Redfin credits.
HASDATA_API_KEY=


# -----------------------------------------------------------------------------------------------------
# 7. DOMAIN (optional)
# -----------------------------------------------------------------------------------------------------

# A domain for the API, e.g. api.yourdomain.com. Leave blank and I will use a free <ip>.sslip.io name with
# automatic HTTPS. If you set one, add an A record pointing to the server IP I give you after the deploy.
API_DOMAIN=
# The website domain, if you have one (configured in Vercel -> Project -> Domains).
WEB_DOMAIN=


# -----------------------------------------------------------------------------------------------------
# 8. GENERATED FOR YOU (no action needed; already filled in .env.credentials)
# -----------------------------------------------------------------------------------------------------

# Shared secret the website uses to call the API.
PENCIL_API_KEY=
# Secret Vercel cron sends to /api/cron/refresh-listings.
CRON_SECRET=
# Postgres master password for RDS.
DB_PASSWORD=
